# ==============================================================================
# CipherQ Production Environment Configuration Template
# Target: Debian 12 (Bookworm) / Arduino UNO Q (4GB RAM, 32GB eMMC)
#
# SECURITY REQUIREMENTS:
# 1. This file must be installed to /etc/cipherq/cipherq.env
# 2. Permissions must be strictly 0600 (readable only by root and cipherq)
#    Command: chmod 0600 /etc/cipherq/cipherq.env && chown cipherq:cipherq /etc/cipherq/cipherq.env
# 3. NEVER commit real production secrets or active tokens to version control.
# ==============================================================================

# Runtime Environment
ENVIRONMENT=production
PROJECT_NAME="CipherQ"
VERSION="1.0.0-rc1"

# Network Binding (Strict Loopback Only - Nginx Reverse Proxy Required)
# NEVER set HOST=0.0.0.0 in production. Plain HTTP must never be exposed on LAN.
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Storage and Key Management Locations
DATA_DIR=/opt/cipherq/data
VAULT_DIR=/opt/cipherq/data/vault
KEYS_DIR=/opt/cipherq/keys
MASTER_KEY_PATH=/opt/cipherq/keys/.vault_master.key

# SQLite Database Location
# Uses aiosqlite with SQLite 3 FTS5 full-text search enabled
DATABASE_URL=sqlite+aiosqlite:////opt/cipherq/data/cipherq.db

# Cookie & Session Security
# COOKIE_SECURE MUST be True when accessed via HTTPS/TLS through Nginx.
COOKIE_SECURE=True
COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=cipherq_session
SESSION_EXPIRE_HOURS=24

# Authentication Rate Limiting (Strict protection against brute-force)
AUTH_RATE_LIMIT_LOGIN_MAX=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_SEC=60
AUTH_RATE_LIMIT_REGISTER_MAX=3
AUTH_RATE_LIMIT_REGISTER_WINDOW_SEC=60

# Authoritative Plan Storage Caps (Decimal GB: 1 GB = 1,000,000,000 bytes)
FREE_QUOTA_BYTES=1000000000
PREMIUM_QUOTA_BYTES=5000000000

# Administrative Operations Token (Guards /api/v1/admin/*)
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=REPLACE_WITH_SECURE_RANDOM_HEX_64_CHARS

# Privacy & Telemetry
# Strict guarantee: Zero external network telemetry, analytics, or cloud AI calls.
ENABLE_TELEMETRY=false
LOG_LEVEL=INFO
